# ============================================================
# AI 減肥生存管家 — 環境變數設定範本
# ============================================================
# 使用方式：
#   1. 複製為 .env（本機開發用）
#      cp .env.example .env
#   2. 填入你的 Token
#   3. 部署到 Render 時，在後台設定同樣的變數
# ============================================================

# ---------- Line Messaging API 設定 ----------
LINE_CHANNEL_SECRET=你的頻道密鑰
LINE_CHANNEL_ACCESS_TOKEN=你的頻道存取權杖


# ---------- OpenRouter 設定（免費 LLM API） ----------
# 註冊 OpenRouter (https://openrouter.ai) → 建立 API Key
# 完全免費，不需綁信用卡
OPENROUTER_API_KEY=你的 OpenRouter API Key

# 使用的 AI 模型（推薦免費模型）
#   openrouter/free                   自動路由到最佳可用免費模型 ✅ 推薦
#   google/gemma-4-31b-it:free        Google Gemma 4 31B（可能被 rate limit）
#   google/gemma-4-26b-a4b-it:free    Google Gemma 4 26B（可能被 rate limit）
AI_MODEL=openrouter/free


# ---------- Notion 設定 ----------
NOTION_TOKEN=你的 Notion Integration Token
DATABASE_ID=你的 Notion Database ID
